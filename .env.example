# dvara - anti-detect scraping REST API (Camoufox/Firefox).

# Static API key. If empty, every request is allowed (internal/dev mode).
# Send it as the X-API-Key header or the `apikey` query parameter.
DVARA_API_KEY=

# Bind address & port (Docker maps the port via compose).
DVARA_HOST=0.0.0.0
DVARA_PORT=8080

# Number of concurrent Firefox processes. Roughly 300MB per browser.
# VPS RAM reference: 4GB -> 4, 8GB -> 8, 16GB -> 16.
DVARA_POOL_SIZE=4

# Max tasks running at once (each task = one incognito context).
DVARA_MAX_CONCURRENT=12

# Default timeout for one render request, in seconds.
# Can be overridden per request via the body field `timeout_s`.
DVARA_TIMEOUT_S=70

# Session database path (storage_state cookies) - SQLite.
DVARA_DB=dvara.db

# 1 = headless, 0 = show a window (debugging). Keep 1 on a server.
DVARA_HEADLESS=1

# Optional default proxy, used when a request does not send `proxy`.
# Format: http://user:pass@host:port  (or socks5://...)
#DVARA_DEFAULT_PROXY=
